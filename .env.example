# Supabase — Project Settings → API → Project URL + anon (or publishable) key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Prefer either key name (client accepts both):
VITE_SUPABASE_ANON_KEY=your-anon-jwt-here
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Cloud sync is off by default (local-only, no login). Set to false to use Supabase.
# VITE_LOCAL_ONLY=false
